DISCORD_TOKEN=put-your-bot-token-here
# Local default. Docker Compose overrides this to /app/data/state.json.
DATA_PATH=./data/state.json
# 32-byte key as 64 hex characters, used to encrypt the state file at rest (AES-256-GCM).
# Generate with: openssl rand -hex 32
# Keep it safe: without it the state file cannot be read. Unset = stored unencrypted.
DATA_ENCRYPTION_KEY=
